---
import config from 'virtual:starlight/user-config';

const links = config.social || [];
---

{links.length > 0 && (
  <>
    {links.map(({ label, href, icon }) => (
      <a
        {href}
        rel="me"
        class="sl-flex cf-social-link"
        data-icon={icon}
        aria-label={label}
        title={label}
        target="_blank"
      >
        <span class="sr-only">{label}</span>
        {icon === 'github' ? (
          <svg class="cf-social-svg cf-social-svg--github" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        ) : icon === 'seti:npm' || (href && href.includes('npmjs.com')) ? (
          <svg class="cf-social-svg cf-social-svg--npm" viewBox="0 0 18 7" fill="currentColor" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
            <path d="M0 0h18v6H9v1H5V6H0V0zm1 5h2V2h1v3h1V1H1v4zm5-4v5h2V5h2V1H6zm2 1h1v2H8V2zm3-1v4h2V2h1v3h1V2h1v3h1V1h-6z"/>
          </svg>
        ) : (
          <span class="cf-social-fallback" aria-hidden="true">{icon}</span>
        )}
      </a>
    ))}
  </>
)}

<style>
  @layer starlight.core {
    a.cf-social-link {
      color: var(--sl-color-text-accent);
      padding: 0.45rem;
      margin: -0.2rem;
      border-radius: 0.65rem;
      transition: color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }
    a.cf-social-link:hover {
      color: var(--sl-color-white);
      background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
      transform: translateY(-1px);
    }
    .cf-social-svg {
      display: block;
      flex-shrink: 0;
    }
    .cf-social-svg--github {
      width: 1.85rem;
      height: 1.85rem;
    }
    .cf-social-svg--npm {
      width: 2.35rem;
      height: auto;
      min-height: 0.92rem;
    }
    @media (max-width: 50rem) {
      a.cf-social-link { padding: 0.55rem; }
      .cf-social-svg--github { width: 2rem; height: 2rem; }
      .cf-social-svg--npm { width: 2.5rem; }
    }
    .cf-social-fallback { font-size: 0.75rem; opacity: 0.8; }
  }
</style>
