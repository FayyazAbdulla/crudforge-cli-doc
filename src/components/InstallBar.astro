---
const cmd = 'npm i -g @team-codeme/crud-forge';
---

<div class="cf-install" id="cf-install">
  <code class="cf-install__cmd">$ {cmd}</code>
  <span class="cf-install__or">or</span>
  <code class="cf-install__cmd">npx @team-codeme/crud-forge</code>
  <button type="button" class="cf-install__copy" data-copy={cmd} aria-label="Copy install command">
    Copy
  </button>
</div>

<script is:inline>
  function bindCfInstallCopy() {
    document.querySelectorAll('.cf-install__copy').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 1500);
        } catch {
          btn.textContent = 'Failed';
        }
      });
    });
  }
  bindCfInstallCopy();
  document.addEventListener('astro:page-load', bindCfInstallCopy);
</script>
