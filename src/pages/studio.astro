      termNativeInput.focus();
    });

    termNativeInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = currentInput.trim();
        termNativeInput.value = '';
        currentInput = '';
        termCurrentInputText.textContent = '';

        if (cmd.length > 0) {
          commandHistory.push(cmd);
          historyPointer = commandHistory.length;
        }

        executeTerminalCommand(cmd);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (commandHistory.length > 0 && historyPointer > 0) {
          historyPointer--;
          termNativeInput.value = commandHistory[historyPointer];
          currentInput = commandHistory[historyPointer];
          termCurrentInputText.textContent = currentInput;
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyPointer < commandHistory.length - 1) {
          historyPointer++;
          termNativeInput.value = commandHistory[historyPointer];
          currentInput = commandHistory[historyPointer];
          termCurrentInputText.textContent = currentInput;
        } else {
          historyPointer = commandHistory.length;
          termNativeInput.value = '';
          currentInput = '';
          termCurrentInputText.textContent = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        handleTabCompletion();
      } else if (e.ctrlKey && e.key === 'l') {
        e.preventDefault();
        clearTerminal();
      } else if (e.ctrlKey && e.key === 'c') {
        appendPromptEcho(currentInput + '^C');
        termNativeInput.value = '';
        currentInput = '';
        termCurrentInputText.textContent = '';
      }
    });

