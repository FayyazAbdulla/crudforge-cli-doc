  districtName String required
}

relationship OneToMany {
  Province{district} to District
}`,
        gdl: `entity Province {
  string provinceCode required
  string provinceName required
  integer index
}

entity District {
  string districtCode required
  string districtName required
}

relationship OneToMany {
  Province{district} to District
