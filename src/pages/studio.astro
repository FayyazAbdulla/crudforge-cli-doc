      const parsed = parseSchema(schemaEditor.value);
      let out = '';

      parsed.entities.forEach(ent => {
        out += `entity ${ent.name} {\n`;
        ent.fields.forEach(f => {
          if (currentFormat === 'gdl') {
            out += `  ${f.type} ${f.name}${f.required ? ' required' : ''}\n`;
          } else {
            out += `  ${f.name} ${f.type}${f.required ? ' required' : ''}\n`;
          }
        });
        out += `}\n\n`;
      });

      parsed.enums.forEach(en => {
        out += `enum ${en.name} {\n  ${en.values.join(', ')}\n}\n\n`;
      });

      parsed.relationships.forEach(rel => {
        out += `relationship ${rel.type} {\n  ${rel.from}${rel.fromField ? `{${rel.fromField}}` : ''} to ${rel.to}${rel.toField ? `{${rel.toField}}` : ''}\n}\n\n`;
      });

      schemaEditor.value = out.trim();
