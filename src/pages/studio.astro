      cfgDisabledGuard, cfgDisabledCountdown, cfgProvisionEnabled, cfgProvisionAdapter, cfgAdminServiceUrl,
      cfgIamEnabled, cfgIamUsers, cfgIamRoles, cfgIamRolePerms, cfgIamUserAccess, cfgIamUserPerms, cfgIamInheritance,
      cfgModelPrefix, cfgEntityPrefix, cfgEntitySuffix, cfgEnumCasing, cfgBackendKind, cfgDoctorTimeout,
      cfgKebabFiles, cfgTestingCi
    ];

    allConfigInputs.forEach(el => {
      if (!el) return;
      el.addEventListener('input', () => {
        syncConditionalDisplays();
        updateConfigYamlFromForm();
      });
      el.addEventListener('change', () => {
        syncConditionalDisplays();
        updateConfigYamlFromForm();
      });
    });

    // Two-way sync: YAML Editor -> Form Controls
    configYamlEditor.addEventListener('input', () => {
      updateYamlGutterAndLines();
      const txt = configYamlEditor.value;
      if (virtualFS && virtualFS['my-app'] && virtualFS['my-app'].children.config) {
        virtualFS['my-app'].children.config.children['crudforge.config.yml'].content = txt;
      }

      function getMatch(regex, fallback) {
        const m = txt.match(regex);
        return m && m[1] !== undefined ? m[1].trim().replace(/^["']|["']$/g, '') : fallback;
      }
      function getBool(regex, fallback) {
        const val = getMatch(regex, null);
        if (val === null) return fallback;
        return val.toLowerCase() === 'true';
      }
      function getNum(regex, fallback) {
        const val = getMatch(regex, null);
        if (val === null) return fallback;
        const n = parseInt(val, 10);
        return isNaN(n) ? fallback : n;
      }

      // Extract Project & Output
      cfgProjectName.value = getMatch(/project:[\s\S]*?name:\s*([^\n\r#]+)/, cfgProjectName.value);
      cfgRepoUrl.value = getMatch(/repositoryUrl:\s*([^\n\r#]*)/, cfgRepoUrl.value);
      cfgInputFile.value = getMatch(/input:[\s\S]*?file:\s*([^\n\r#]+)/, cfgInputFile.value);
      cfgInputType.value = getMatch(/input:[\s\S]*?type:\s*([^\n\r#]+)/, cfgInputType.value);
      cfgOutputDir.value = getMatch(/output:[\s\S]*?directory:\s*([^\n\r#]+)/, cfgOutputDir.value);
      cfgOverwritePolicy.value = getMatch(/overwritePolicy:\s*([^\n\r#]+)/, cfgOverwritePolicy.value);
      cfgOutputStructure.value = getMatch(/output:[\s\S]*?structure:\s*([^\n\r#]+)/, cfgOutputStructure.value);
      cfgEmbedConfig.checked = getBool(/embedConfig:\s*([^\n\r#]+)/, cfgEmbedConfig.checked);
      cfgAiDocs.checked = getBool(/aiDocs:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgAiDocs.checked);
      cfgTeamPack.checked = getBool(/teamPack:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgTeamPack.checked);
      cfgGitEnabled.checked = getBool(/git:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgGitEnabled.checked);

      // Extract Fuse & Rendering
      cfgFuseEnabled.checked = getBool(/fuse:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgFuseEnabled.checked);
      cfgRendering.value = getMatch(/rendering:\s*([^\n\r#]+)/, cfgRendering.value);
      cfgCleanLayout.checked = getBool(/cleanLayout:\s*([^\n\r#]+)/, cfgCleanLayout.checked);
      cfgIncludePrebuilt.checked = getBool(/includePrebuilt:\s*([^\n\r#]+)/, cfgIncludePrebuilt.checked);
      cfgFolderType.value = getMatch(/folderType:\s*([^\n\r#]*)/, cfgFolderType.value);
      cfgSidebarTheme.value = getMatch(/sidebarTheme:\s*([^\n\r#]+)/, cfgSidebarTheme.value);
      cfgThemeScheme.value = getMatch(/scheme:\s*([^\n\r#]+)/, cfgThemeScheme.value);
      cfgThemePrimary.value = getMatch(/primary:\s*["']?([^"'\n\r#]+)["']?/, cfgThemePrimary.value);
      cfgThemeError.value = getMatch(/error:\s*["']?([^"'\n\r#]+)["']?/, cfgThemeError.value);
      if (/^#[0-9A-Fa-f]{6}$/.test(cfgThemePrimary.value)) cfgThemePrimaryPicker.value = cfgThemePrimary.value;
      if (/^#[0-9A-Fa-f]{6}$/.test(cfgThemeError.value)) cfgThemeErrorPicker.value = cfgThemeError.value;

      // Extract UI & Form Modes
      cfgViewMode.value = getMatch(/viewMode:\s*([^\n\r#]+)/, cfgViewMode.value);
      cfgFormMode.value = getMatch(/formMode:\s*([^\n\r#]+)/, cfgFormMode.value);
      cfgSearchMode.value = getMatch(/searchMode:\s*([^\n\r#]+)/, cfgSearchMode.value);
      cfgCardBreakpoint.value = getNum(/cardBreakpointPx:\s*(\d+)/, cfgCardBreakpoint.value);
      cfgSkeletonLoading.checked = getBool(/useSkeletonLoading:\s*([^\n\r#]+)/, cfgSkeletonLoading.checked);
      cfgSnackbarTop.checked = getBool(/snackbarPositionTop:\s*([^\n\r#]+)/, cfgSnackbarTop.checked);
      cfgGridMobile.value = getNum(/mobile:\s*(\d+)/, cfgGridMobile.value);
      cfgGridTablet.value = getNum(/tablet:\s*(\d+)/, cfgGridTablet.value);
      cfgGridDesktop.value = getNum(/desktop:\s*(\d+)/, cfgGridDesktop.value);

      // Extract Form Behavior & Fields
      cfgUppercaseInputs.checked = getBool(/uppercaseInputs:\s*([^\n\r#]+)/, cfgUppercaseInputs.checked);
      cfgUpdateOn.value = getMatch(/updateOn:\s*([^\n\r#]+)/, cfgUpdateOn.value);
      cfgShowErrorMessages.checked = getBool(/showErrorMessages:\s*([^\n\r#]+)/, cfgShowErrorMessages.checked);
      cfgAutoFocusFirst.checked = getBool(/autoFocusFirstInput:\s*([^\n\r#]+)/, cfgAutoFocusFirst.checked);
      cfgAuditEnabled.checked = getBool(/fields:[\s\S]*?audit:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgAuditEnabled.checked);
      cfgAuditHideForms.checked = getBool(/hideInForms:\s*([^\n\r#]+)/, cfgAuditHideForms.checked);
      cfgAuditHideFilters.checked = getBool(/hideInFilters:\s*([^\n\r#]+)/, cfgAuditHideFilters.checked);
      cfgAuditHideSearch.checked = getBool(/hideInSearch:\s*([^\n\r#]+)/, cfgAuditHideSearch.checked);
      cfgAuditHideLists.checked = getBool(/hideInLists:\s*([^\n\r#]+)/, cfgAuditHideLists.checked);
      cfgAuditShowDetail.checked = getBool(/showInDetail:\s*([^\n\r#]+)/, cfgAuditShowDetail.checked);
      cfgDateFormat.value = getMatch(/dateMediumFormat:\s*["']?([^"'\n\r#]+)["']?/, cfgDateFormat.value);
      cfgNumberFormat.value = getMatch(/numberFormat:\s*["']?([^"'\n\r#]+)["']?/, cfgNumberFormat.value);
      cfgStringCase.value = getMatch(/stringCase:\s*([^\n\r#]+)/, cfgStringCase.value);

      // Extract API & Proxy
      cfgApiBaseUrl.value = getMatch(/api:[\s\S]*?baseUrl:\s*["']?([^"'\n\r#]+)["']?/, cfgApiBaseUrl.value);
      cfgApiMicroservice.value = getMatch(/api:[\s\S]*?microservice:\s*["']?([^"'\n\r#]*)/, cfgApiMicroservice.value);
      cfgEndpointStyle.value = getMatch(/endpointStyle:\s*([^\n\r#]+)/, cfgEndpointStyle.value);
      cfgDateLib.value = getMatch(/dateLibrary:\s*([^\n\r#]+)/, cfgDateLib.value);
      cfgResponseType.value = getMatch(/responseType:\s*([^\n\r#]+)/, cfgResponseType.value);
      cfgProxyWrite.value = getMatch(/proxy:[\s\S]*?write:\s*([^\n\r#]+)/, cfgProxyWrite.value);
      cfgDevPort.value = getNum(/devServer:[\s\S]*?port:\s*(\d+)/, cfgDevPort.value);

      // Extract Generate Toggles
      cfgGenModels.checked = getBool(/models:\s*([^\n\r#]+)/, cfgGenModels.checked);
      cfgGenServices.checked = getBool(/services:\s*([^\n\r#]+)/, cfgGenServices.checked);
      cfgGenFormServices.checked = getBool(/formServices:\s*([^\n\r#]+)/, cfgGenFormServices.checked);
      cfgGenRoutes.checked = getBool(/routes:\s*([^\n\r#]+)/, cfgGenRoutes.checked);
      cfgGenEnums.checked = getBool(/enums:\s*([^\n\r#]+)/, cfgGenEnums.checked);
      cfgGenRelationships.checked = getBool(/relationships:\s*([^\n\r#]+)/, cfgGenRelationships.checked);
      cfgGenList.checked = getBool(/list:\s*([^\n\r#]+)/, cfgGenList.checked);
      cfgGenCard.checked = getBool(/card:\s*([^\n\r#]+)/, cfgGenCard.checked);
      cfgGenDetail.checked = getBool(/detail:\s*([^\n\r#]+)/, cfgGenDetail.checked);
      cfgGenForm.checked = getBool(/form:\s*([^\n\r#]+)/, cfgGenForm.checked);
      cfgGenFormPage.checked = getBool(/formPage:\s*([^\n\r#]+)/, cfgGenFormPage.checked);
      cfgGenValidators.checked = getBool(/validators:\s*([^\n\r#]+)/, cfgGenValidators.checked);
      cfgGenFilter.checked = getBool(/filter:\s*([^\n\r#]+)/, cfgGenFilter.checked);
      cfgGenActions.checked = getBool(/actions:\s*([^\n\r#]+)/, cfgGenActions.checked);
      cfgGenConstants.checked = getBool(/constants:\s*([^\n\r#]+)/, cfgGenConstants.checked);
      cfgGenTests.checked = getBool(/tests:\s*([^\n\r#]+)/, cfgGenTests.checked);
      cfgGenSharedAssets.checked = getBool(/sharedAssets:\s*([^\n\r#]+)/, cfgGenSharedAssets.checked);

      // Extract Mock Data
      cfgMockEnabled.checked = getBool(/mock:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgMockEnabled.checked);
      cfgMockRecords.value = getNum(/recordsPerEntity:\s*(\d+)/, cfgMockRecords.value);
      cfgMockPrefix.value = getMatch(/stringPrefix:\s*["']?([^"'\n\r#]+)["']?/, cfgMockPrefix.value);

      // Extract Auth & Keycloak
      cfgAuthProvider.value = getMatch(/auth:[\s\S]*?provider:\s*([^\n\r#]+)/, cfgAuthProvider.value);
      cfgServerUrl.value = getMatch(/serverUrl:\s*["']?([^"'\n\r#]+)["']?/, cfgServerUrl.value);
      cfgRealm.value = getMatch(/realm:\s*["']?([^"'\n\r#]+)["']?/, cfgRealm.value);
      cfgClientId.value = getMatch(/clientId:\s*["']?([^"'\n\r#]+)["']?/, cfgClientId.value);
      cfgAdminBaseUrl.value = getMatch(/adminBaseUrl:\s*["']?([^"'\n\r#]+)["']?/, cfgAdminBaseUrl.value);
      cfgUseMockAuth.checked = getBool(/useMockAuth:\s*([^\n\r#]+)/, cfgUseMockAuth.checked);
      cfgForwardedProto.value = getMatch(/forwardedProto:\s*["']?([^"'\n\r#]*)/, cfgForwardedProto.value);
      cfgLoginUser.value = getMatch(/username:\s*["']?([^"'\n\r#]+)["']?/, cfgLoginUser.value);
      cfgLoginPass.value = getMatch(/password:\s*["']?([^"'\n\r#]+)["']?/, cfgLoginPass.value);
      cfgIdleTimeout.value = getNum(/idleTimeoutMs:\s*(\d+)/, cfgIdleTimeout.value);
      cfgSessionPersist.checked = getBool(/persistAcrossReload:\s*([^\n\r#]+)/, cfgSessionPersist.checked);
      cfgCrossTabSync.checked = getBool(/crossTabSync:\s*([^\n\r#]+)/, cfgCrossTabSync.checked);
      cfgRefreshFocus.checked = getBool(/refreshOnFocus:\s*([^\n\r#]+)/, cfgRefreshFocus.checked);
      cfgDisabledGuard.checked = getBool(/disabledAccount:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgDisabledGuard.checked);
      cfgDisabledCountdown.value = getNum(/countdownSeconds:\s*(\d+)/, cfgDisabledCountdown.value);
      cfgProvisionEnabled.checked = getBool(/provision:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgProvisionEnabled.checked);
      cfgProvisionAdapter.value = getMatch(/adapter:\s*([^\n\r#]+)/, cfgProvisionAdapter.value);
      cfgAdminServiceUrl.value = getMatch(/adminServiceUrl:\s*["']?([^"'\n\r#]+)["']?/, cfgAdminServiceUrl.value);

      // Extract IAM
      cfgIamEnabled.checked = getBool(/iam:[\s\S]*?enabled:\s*([^\n\r#]+)/, cfgIamEnabled.checked);
      cfgIamUsers.checked = getBool(/users:\s*([^\n\r#]+)/, cfgIamUsers.checked);
      cfgIamRoles.checked = getBool(/roles:\s*([^\n\r#]+)/, cfgIamRoles.checked);
      cfgIamRolePerms.checked = getBool(/rolePermissions:\s*([^\n\r#]+)/, cfgIamRolePerms.checked);
      cfgIamUserAccess.checked = getBool(/userAccess:\s*([^\n\r#]+)/, cfgIamUserAccess.checked);
      cfgIamUserPerms.checked = getBool(/userPermissions:\s*([^\n\r#]+)/, cfgIamUserPerms.checked);
      cfgIamInheritance.checked = getBool(/inheritance:\s*([^\n\r#]+)/, cfgIamInheritance.checked);

      // Extract Conventions & Backend
      cfgModelPrefix.value = getMatch(/modelInterfacePrefix:\s*["']?([^"'\n\r#]+)["']?/, cfgModelPrefix.value);
      cfgEnumCasing.value = getMatch(/enumValueCasing:\s*([^\n\r#]+)/, cfgEnumCasing.value);
      cfgBackendKind.value = getMatch(/backend:[\s\S]*?kind:\s*([^\n\r#]+)/, cfgBackendKind.value);
      cfgDoctorTimeout.value = getNum(/doctor:[\s\S]*?timeoutMs:\s*(\d+)/, cfgDoctorTimeout.value);
      cfgKebabFiles.checked = getBool(/kebabCaseFiles:\s*([^\n\r#]+)/, cfgKebabFiles.checked);
      cfgTestingCi.checked = getBool(/testing:[\s\S]*?ci:\s*([^\n\r#]+)/, cfgTestingCi.checked);

      syncConditionalDisplays();
    });

    configYamlEditor.addEventListener('scroll', () => {
      yamlGutter.scrollTop = configYamlEditor.scrollTop;
    });

    // Copy YAML Action
    copyConfigYamlBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(configYamlEditor.value).then(() => {
        const orig = copyConfigYamlBtn.innerHTML;
        copyConfigYamlBtn.innerHTML = '<span>✓ Copied!</span>';
        setTimeout(() => { copyConfigYamlBtn.innerHTML = orig; }, 1800);
      });
    });

    // Download YAML Action
    downloadConfigYamlBtn.addEventListener('click', () => {
      const blob = new Blob([configYamlEditor.value], { type: 'text/yaml' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'crudforge.config.yml';
      a.click();
      URL.revokeObjectURL(url);
    });

    // Preset configurations
    configPresetSelect.addEventListener('change', (e) => {
      const preset = e.target.value;
      if (preset === 'default') {
        cfgProjectName.value = 'CRUDForge App';
        cfgAuthProvider.value = 'none';
        cfgIamEnabled.checked = false;
        cfgMockEnabled.checked = false;
        cfgRendering.value = 'spa';
        cfgFuseEnabled.checked = true;
        cfgCleanLayout.checked = true;
        cfgIncludePrebuilt.checked = false;
        cfgFolderType.value = '';
        cfgSidebarTheme.value = 'white';
        cfgOverwritePolicy.value = 'fail';
        cfgOutputStructure.value = 'shared-central';
        cfgViewMode.value = 'table';
        cfgFormMode.value = 'sidebar';
        cfgSearchMode.value = 'field';
        cfgThemePrimary.value = '#791EFF';
        cfgThemePrimaryPicker.value = '#791EFF';
        cfgDevPort.value = 4200;
      } else if (preset === 'keycloak') {
        cfgProjectName.value = 'CRUDForge Enterprise';
        cfgAuthProvider.value = 'keycloak';
        cfgServerUrl.value = 'http://62.84.188.166:31740';
        cfgRealm.value = 'CRUD-FORDGE';
        cfgClientId.value = 'crudforge-client-QA';
        cfgAdminBaseUrl.value = '/auth';
        cfgLoginUser.value = 'crud';
        cfgLoginPass.value = 'crud';
        cfgSessionPersist.checked = true;
        cfgCrossTabSync.checked = true;
        cfgRefreshFocus.checked = true;
        cfgDisabledGuard.checked = true;
        cfgDisabledCountdown.value = 20;
        cfgIamEnabled.checked = true;
        cfgIamUsers.checked = true;
        cfgIamRoles.checked = true;
        cfgIamRolePerms.checked = true;
        cfgIamUserAccess.checked = true;
        cfgIamUserPerms.checked = true;
        cfgIamInheritance.checked = true;
        cfgRendering.value = 'spa';
        cfgFuseEnabled.checked = true;
        cfgOverwritePolicy.value = 'merge';
      } else if (preset === 'ssr') {
        cfgProjectName.value = 'CRUDForge Universal SSR';
        cfgRendering.value = 'ssr';
        cfgSsrHosts.value = 'localhost, 127.0.0.1, admin.example.com';
        cfgFuseEnabled.checked = true;
        cfgCleanLayout.checked = true;
        cfgOverwritePolicy.value = 'fail';
      } else if (preset === 'pmb') {
        cfgProjectName.value = 'PMB Development Test';
        cfgAuthProvider.value = 'keycloak';
        cfgServerUrl.value = 'http://62.84.188.166:31740';
        cfgRealm.value = 'CRUD-FORDGE';
        cfgClientId.value = 'crudforge-client-QA';
        cfgApiMicroservice.value = 'referenceModule';
        cfgFolderType.value = 'micro-functions';
        cfgOutputStructure.value = 'entity-folder';
        cfgProvisionEnabled.checked = true;
        cfgProvisionAdapter.value = 'admin-service';
        cfgAdminServiceUrl.value = 'http://62.84.188.166:31740/';
        cfgIamEnabled.checked = false;
        cfgOverwritePolicy.value = 'merge';
      } else if (preset === 'full') {
        cfgProjectName.value = 'CRUDForge Full Stack';
        cfgAuthProvider.value = 'keycloak';
        cfgServerUrl.value = 'http://62.84.188.166:31740';
        cfgRealm.value = 'CRUD-FORDGE';
        cfgClientId.value = 'crudforge-client-QA';
        cfgIamEnabled.checked = true;
        cfgIamUsers.checked = true;
        cfgIamRoles.checked = true;
        cfgIamRolePerms.checked = true;
        cfgIamUserAccess.checked = true;
        cfgIamUserPerms.checked = true;
        cfgIamInheritance.checked = true;
        cfgMockEnabled.checked = true;
        cfgMockRecords.value = 10;
        cfgMockPrefix.value = 'Mock ';
        cfgTestingCi.checked = true;
        cfgGenTests.checked = true;
        cfgAuditEnabled.checked = true;
        cfgOverwritePolicy.value = 'merge';
      } else if (preset === 'mock') {
        cfgProjectName.value = 'CRUDForge Mock Prototype';
        cfgAuthProvider.value = 'none';
        cfgIamEnabled.checked = false;
        cfgMockEnabled.checked = true;
        cfgMockRecords.value = 15;
        cfgMockPrefix.value = 'Mock ';
        cfgViewMode.value = 'card';
        cfgFormMode.value = 'sidebar';
      }
      syncConditionalDisplays();
      updateConfigYamlFromForm();
    });

    // =========================================================================
    // MODE SWITCHER
    // =========================================================================
    const modeTabs = document.querySelectorAll('.mode-tab');
    const schemaStudioView = document.getElementById('schemaStudioView');
    const configStudioView = document.getElementById('configStudioView');
    const schemaTemplateControls = document.getElementById('schemaTemplateControls');
    const configPresetControls = document.getElementById('configPresetControls');
    const formatPillsContainer = document.getElementById('formatPills');
    const exportSvgBtn = document.getElementById('exportSvgBtn');
    const formatCodeBtn = document.getElementById('formatCodeBtn');
    const downloadSchemaBtn = document.getElementById('downloadSchemaBtn');

    modeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        modeTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const mode = tab.dataset.mode;
        currentMode = mode;

        if (mode === 'schema') {
          schemaStudioView.classList.add('active');
          configStudioView.classList.remove('active');
          schemaTemplateControls.style.display = 'flex';
          configPresetControls.style.display = 'none';
          formatPillsContainer.style.display = 'flex';
          exportSvgBtn.style.display = 'inline-flex';
          formatCodeBtn.style.display = 'inline-flex';
          downloadSchemaBtn.style.display = 'inline-flex';
          updateCanvasTransform();
        } else {
          schemaStudioView.classList.remove('active');
          configStudioView.classList.add('active');
          schemaTemplateControls.style.display = 'none';
          configPresetControls.style.display = 'flex';
          formatPillsContainer.style.display = 'none';
          exportSvgBtn.style.display = 'none';
          formatCodeBtn.style.display = 'none';
          downloadSchemaBtn.style.display = 'none';
          updateConfigYamlFromForm();
          termNativeInput.focus();
        }
      });
    });

    // Welcome message in terminal — cyber banner by default
    function initTerminal() {
      termOutputContainer.innerHTML = '';
      appendTermLine(ASCII_BANNERS.cyber);
      appendTermLine(`<div style="margin-bottom: 3px;"><span class="ansi-purple ansi-bold">CRUDForge CLI v1.0.0</span> — <span class="ansi-cyan">Interactive Web Terminal</span></div>`);
      appendTermLine(`<div style="margin-bottom: 3px;"><span class="ansi-dim">Full terminal emulator loaded in <span class="ansi-blue">~/work/my-app</span> (zsh 5.9)</span></div>`);
      appendTermLine(`<div style="margin-bottom: 6px;"><span class="ansi-dim">Type <span class="ansi-yellow">help</span>, <span class="ansi-yellow">banner</span>, or <span class="ansi-yellow">cat config/crudforge.config.yml</span>.</span></div>`);
    }

    // Initialize (Default: Config Studio + Terminal)
    try {
      applyTemplate('hr', 'jdl');
    } catch (err) {
      console.warn('Template init:', err);
    }
    try {
      syncConditionalDisplays();
      updateConfigYamlFromForm();
    } catch (err) {
      console.error('Config init:', err);
    }
    try {
      initTerminal();
    } catch (err) {
      console.error('Terminal init:', err);
    }
    setTimeout(() => {
      termNativeInput?.focus();
    }, 150);
  </script>
</body>
</html>
