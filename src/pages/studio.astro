    function updateGutter() {
      const lines = schemaEditor.value.split('\n').length;
      let gutterHtml = '';
      for (let i = 1; i <= lines; i++) {
        gutterHtml += `${i}<br>`;
      }
      editorGutter.innerHTML = gutterHtml;
    }

    schemaEditor.addEventListener('input', () => {
      updateGutter();
      const parsed = parseSchema(schemaEditor.value);
      renderDiagram(parsed);
    });

    schemaEditor.addEventListener('scroll', () => {
      editorGutter.scrollTop = schemaEditor.scrollTop;
    });

    schemaEditor.addEventListener('keyup', updateCursorPos);
    schemaEditor.addEventListener('click', updateCursorPos);

    function updateCursorPos() {
      const text = schemaEditor.value.substring(0, schemaEditor.selectionStart);
      const lines = text.split('\n');
      const line = lines.length;
      const col = lines[lines.length - 1].length + 1;
      document.getElementById('editorLineCount').textContent = `Line: ${line}, Col: ${col}`;
    }

    document.getElementById('snipEntityBtn').addEventListener('click', () => {
      const snip = currentFormat === 'gdl' 
        ? `\nentity NewEntity {\n  string name required\n  bigDecimal amount\n}\n`
        : `\nentity NewEntity {\n  name String required\n  amount BigDecimal\n}\n`;
      schemaEditor.value += snip;
      updateGutter();
      renderDiagram(parseSchema(schemaEditor.value));
    });

    document.getElementById('snipEnumBtn').addEventListener('click', () => {
      schemaEditor.value += `\nenum StatusType {\n  ACTIVE, INACTIVE, ARCHIVED\n}\n`;
      updateGutter();
      renderDiagram(parseSchema(schemaEditor.value));
    });

    document.getElementById('snipRelBtn').addEventListener('click', () => {
      schemaEditor.value += `\nrelationship OneToMany {\n  SourceEntity{target} to TargetEntity\n}\n`;
      updateGutter();
