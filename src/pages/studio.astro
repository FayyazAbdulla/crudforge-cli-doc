      },
      minimal: {
        jdl: `entity Item {
  title String required
  description String
  active Boolean
}`,
        gdl: `entity Item {
  string title required
  string description
  boolean active
}`
      }
    };

    // =========================================================================
    // GLOBAL STATE
    // =========================================================================
    let currentMode = 'config';
    let currentFormat = 'jdl';
    let currentTemplate = 'hr';
    let zoomLevel = 1.0;
    let panX = 40;
    let panY = 40;
    let isPanning = false;
    let startX = 0;
    let startY = 0;
    let activeDragNode = null;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    const schemaEditor = document.getElementById('schemaEditor');
    const editorGutter = document.getElementById('editorGutter');
    const nodesContainer = document.getElementById('nodesContainer');
    const relationshipSvg = document.getElementById('relationshipSvg');
    const canvasViewport = document.getElementById('canvasViewport');
    const diagramWorld = document.getElementById('diagramWorld');
    const validationBanner = document.getElementById('validationBanner');
    const validationText = document.getElementById('validationText');
    const statEntities = document.getElementById('statEntities');
    const statEnums = document.getElementById('statEnums');
    const statRelations = document.getElementById('statRelations');
    const zoomLevelText = document.getElementById('zoomLevelText');

    let nodePositions = {};

    // =========================================================================
    // SCHEMA PARSER & DIAGRAM
    // =========================================================================
    function parseSchema(text) {
      const entities = [];
      const enums = [];
      const relationships = [];

      const clean = text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '');

      // Parse Enums
      const enumRegex = /enum\s+([A-Za-z0-9_]+)\s*\{([^}]*)\}/g;
      let match;
      while ((match = enumRegex.exec(clean)) !== null) {
        const name = match[1];
        const rawVals = match[2].split(',').map(v => v.trim()).filter(Boolean);
        enums.push({ name, values: rawVals });
      }

      // Parse Entities
      const entityRegex = /entity\s+([A-Za-z0-9_]+)(?:\s*\([^)]*\))?\s*\{([^}]*)\}/g;
      while ((match = entityRegex.exec(clean)) !== null) {
        const name = match[1];
        const body = match[2];
        const fields = [];
        const lines = body.split('\n').map(l => l.trim()).filter(Boolean);

        for (const line of lines) {
          const tokens = line.split(/\s+/).filter(Boolean);
          if (tokens.length >= 2) {
            let fieldName, fieldType;
            if (currentFormat === 'gdl') {
              fieldType = tokens[0];
              fieldName = tokens[1];
            } else {
              fieldName = tokens[0];
              fieldType = tokens[1];
            }
            const required = line.toLowerCase().includes('required');
            fields.push({ name: fieldName, type: fieldType, required });
          }
        }
        entities.push({ name, fields });
      }

      // Parse Relationships (brace-aware: Country{region} to Region)
      const relHeaderRegex = /relationship\s+(OneToOne|OneToMany|ManyToOne|ManyToMany)\s*\{/g;
      while ((match = relHeaderRegex.exec(clean)) !== null) {
        const type = match[1];
        let depth = 1;
        let i = relHeaderRegex.lastIndex;
        let body = '';
        while (i < clean.length && depth > 0) {
          const ch = clean[i];
          if (ch === '{') depth++;
          else if (ch === '}') {
            depth--;
            if (depth === 0) break;
          }
          if (depth > 0) body += ch;
          i++;
        }
        relHeaderRegex.lastIndex = i + 1;

        const relLines = body.split(/[\n;]+/).map(l => l.trim()).filter(Boolean);
        for (const line of relLines) {
          const relMatch = /([A-Za-z0-9_]+)(?:\{([^}]*)\})?\s+to\s+([A-Za-z0-9_]+)(?:\{([^}]*)\})?/.exec(line);
          if (relMatch) {
            relationships.push({
              type,
              from: relMatch[1],
              fromField: relMatch[2] || '',
              to: relMatch[3],
              toField: relMatch[4] || ''
            });
          }
        }
      }

      return { entities, enums, relationships };
    }

    function renderDiagram(parsed) {
      statEntities.textContent = parsed.entities.length;
      statEnums.textContent = parsed.enums.length;
      statRelations.textContent = parsed.relationships.length;

      if (parsed.entities.length === 0 && parsed.enums.length === 0) {
        validationBanner.className = 'validation-banner has-error';
        validationText.textContent = 'No entities or enums found in schema.';
      } else {
        validationBanner.className = 'validation-banner';
        validationText.textContent = `Valid schema: ${parsed.entities.length} entities, ${parsed.enums.length} enums, ${parsed.relationships.length} relations.`;
      }

      nodesContainer.innerHTML = '';

      const totalItems = [...parsed.entities, ...parsed.enums];
      const cols = Math.max(2, Math.min(3, Math.ceil(Math.sqrt(totalItems.length))));
      const colWidth = 280;
      const rowHeights = [];

      // Pre-estimate row heights from field counts so tall tables don't overlap
      totalItems.forEach((item, i) => {
        const row = Math.floor(i / cols);
        const fieldCount = item.fields ? item.fields.length : (item.values ? item.values.length : 0);
        const estH = 44 + Math.max(1, fieldCount) * 22 + 16;
        rowHeights[row] = Math.max(rowHeights[row] || 0, estH);
      });

      const rowTops = [];
      let accY = 48;
      for (let r = 0; r < rowHeights.length; r++) {
        rowTops[r] = accY;
        accY += rowHeights[r] + 48;
      }

      let idx = 0;
      // Carry Astro scoped class onto JS-created nodes (if styles are scoped)
      const astroScope = [...(nodesContainer.classList || [])].find((c) => c.startsWith('astro-')) || '';

      function placeNode(name) {
        if (!nodePositions[name]) {
          const row = Math.floor(idx / cols);
          const col = idx % cols;
          nodePositions[name] = {
            x: 48 + col * colWidth,
            y: rowTops[row] ?? (48 + row * 200)
          };
        }
        idx++;
        return nodePositions[name];
      }

      parsed.entities.forEach(ent => {
        const pos = placeNode(ent.name);

        const node = document.createElement('div');
        node.className = ['diagram-node', astroScope].filter(Boolean).join(' ');
        node.id = `node-${ent.name}`;
        node.dataset.name = ent.name;
        node.style.left = `${pos.x}px`;
        node.style.top = `${pos.y}px`;
        node.style.position = 'absolute';

        let fieldsHtml = '';
        ent.fields.forEach(f => {
          fieldsHtml += `
            <div class="node-field-row">
              <span class="field-name ${f.required ? 'required' : ''}">${f.name}</span>
              <span class="field-type">${f.type}</span>
            </div>
          `;
        });

        node.innerHTML = `
          <div class="node-header ${astroScope}">
            <span class="${astroScope}">${ent.name}</span>
            <span class="node-stereotype ${astroScope}">&lt;&lt;entity&gt;&gt;</span>
          </div>
          <div class="node-fields ${astroScope}">
            ${fieldsHtml || '<div style="color: #6B7280; font-size: 0.7rem;">(no fields)</div>'}
          </div>
        `;
        // Stamp scope class on nested field rows created via innerHTML
        if (astroScope) node.querySelectorAll('*').forEach((el) => el.classList.add(astroScope));

        node.addEventListener('mousedown', (e) => onNodeMouseDown(e, ent.name));
        nodesContainer.appendChild(node);
      });

      parsed.enums.forEach(en => {
        const pos = placeNode(en.name);

        const node = document.createElement('div');
        node.className = ['diagram-node', 'is-enum', astroScope].filter(Boolean).join(' ');
        node.id = `node-${en.name}`;
        node.dataset.name = en.name;
        node.style.left = `${pos.x}px`;
        node.style.top = `${pos.y}px`;
        node.style.position = 'absolute';

        let valsHtml = '';
        en.values.forEach(v => {
          valsHtml += `<div class="enum-val">• ${v}</div>`;
        });

        node.innerHTML = `
          <div class="node-header ${astroScope}">
            <span class="${astroScope}">${en.name}</span>
            <span class="node-stereotype ${astroScope}">&lt;&lt;enum&gt;&gt;</span>
          </div>
          <div class="node-fields ${astroScope}">
            ${valsHtml}
          </div>
        `;
        if (astroScope) node.querySelectorAll('*').forEach((el) => el.classList.add(astroScope));

        node.addEventListener('mousedown', (e) => onNodeMouseDown(e, en.name));
        nodesContainer.appendChild(node);
      });

      // Second pass: draw lines after layout so offsetWidth/Height are accurate
      requestAnimationFrame(() => drawRelationships(parsed.relationships));
    }

    function drawRelationships(relationships) {
      while (relationshipSvg.childNodes.length > 1) {
        relationshipSvg.removeChild(relationshipSvg.lastChild);
      }

      relationships.forEach((rel) => {
        const fromEl = document.getElementById(`node-${rel.from}`);
        const toEl = document.getElementById(`node-${rel.to}`);

        if (!fromEl || !toEl) return;

        const fromPos = nodePositions[rel.from];
        const toPos = nodePositions[rel.to];
        if (!fromPos || !toPos) return;

        const fromWidth = fromEl.offsetWidth || 200;
        const fromHeight = fromEl.offsetHeight || 120;
        const toWidth = toEl.offsetWidth || 200;
        const toHeight = toEl.offsetHeight || 120;

        const startX = fromPos.x + fromWidth / 2;
        const startY = fromPos.y + fromHeight / 2;
        const endX = toPos.x + toWidth / 2;
        const endY = toPos.y + toHeight / 2;

        const dx = endX - startX;
        const dy = endY - startY;
        const ctrlX1 = startX + dx * 0.4;
        const ctrlY1 = startY;
        const ctrlX2 = startX + dx * 0.6;
        const ctrlY2 = endY;

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', `M ${startX} ${startY} C ${ctrlX1} ${ctrlY1}, ${ctrlX2} ${ctrlY2}, ${endX} ${endY}`);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#9B5CFF');
        path.setAttribute('stroke-width', '2');
        path.setAttribute('stroke-dasharray', rel.type === 'ManyToMany' ? '4 4' : 'none');
        path.setAttribute('marker-end', 'url(#arrow)');
        path.setAttribute('opacity', '0.85');
        relationshipSvg.appendChild(path);

        const midX = (startX + endX) / 2;
        const midY = (startY + endY) / 2;
        const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('x', midX);
        text.setAttribute('y', midY - 6);
        text.setAttribute('fill', '#22D3EE');
        text.setAttribute('font-size', '10');
        text.setAttribute('font-family', 'ui-monospace, monospace');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = rel.type === 'OneToMany' ? '(1..*)' : (rel.type === 'ManyToOne' ? '(*..1)' : (rel.type === 'ManyToMany' ? '(*..*)' : '(1..1)'));
        relationshipSvg.appendChild(text);
      });
    }

    // =========================================================================
    // CANVAS TRANSFORMS
    // =========================================================================
    function updateCanvasTransform() {
      diagramWorld.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomLevel})`;
      zoomLevelText.textContent = `${Math.round(zoomLevel * 100)}%`;
    }

    canvasViewport.addEventListener('wheel', (e) => {
      e.preventDefault();
      const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;
      const newZoom = Math.min(Math.max(0.3, zoomLevel * zoomFactor), 2.5);
      
      const rect = canvasViewport.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      panX = mouseX - (mouseX - panX) * (newZoom / zoomLevel);
      panY = mouseY - (mouseY - panY) * (newZoom / zoomLevel);
      zoomLevel = newZoom;

      updateCanvasTransform();
    });

    canvasViewport.addEventListener('mousedown', (e) => {
      if (e.target === canvasViewport || e.target === relationshipSvg || e.target === diagramWorld) {
        isPanning = true;
        startX = e.clientX - panX;
        startY = e.clientY - panY;
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (isPanning) {
        panX = e.clientX - startX;
        panY = e.clientY - startY;
        updateCanvasTransform();
      } else if (activeDragNode) {
        const x = (e.clientX - panX) / zoomLevel - dragOffsetX;
        const y = (e.clientY - panY) / zoomLevel - dragOffsetY;
        nodePositions[activeDragNode] = { x, y };

        const nodeEl = document.getElementById(`node-${activeDragNode}`);
        if (nodeEl) {
          nodeEl.style.left = `${x}px`;
          nodeEl.style.top = `${y}px`;
        }

        const parsed = parseSchema(schemaEditor.value);
        drawRelationships(parsed.relationships);
      }
    });

    window.addEventListener('mouseup', () => {
      isPanning = false;
      activeDragNode = null;
    });

    function onNodeMouseDown(e, nodeName) {
      e.stopPropagation();
      activeDragNode = nodeName;
      const pos = nodePositions[nodeName] || { x: 0, y: 0 };
      dragOffsetX = (e.clientX - panX) / zoomLevel - pos.x;
      dragOffsetY = (e.clientY - panY) / zoomLevel - pos.y;
    }

    document.getElementById('zoomInBtn').addEventListener('click', () => {
      zoomLevel = Math.min(2.5, zoomLevel * 1.2);
      updateCanvasTransform();
    });

    document.getElementById('zoomOutBtn').addEventListener('click', () => {
