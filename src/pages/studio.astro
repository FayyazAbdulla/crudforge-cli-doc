---
// Compatibility entry point only. Studio is built in ../crudforge-studio.
const configuredUrl = import.meta.env.PUBLIC_STUDIO_URL;
const studioUrl = configuredUrl || (import.meta.env.DEV ? 'http://127.0.0.1:4200' : 'https://crudforge-studio.teamcodeme.com');
if (studioUrl && !/^https?:\/\//.test(studioUrl)) {
  throw new Error('PUBLIC_STUDIO_URL must be an absolute HTTP(S) URL');
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CRUDForge Studio has moved</title>
    {studioUrl && <meta http-equiv="refresh" content={`0;url=${studioUrl}`} />}
    <link rel="icon" href="/favicon.png" />
    <style>
      body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 15vh auto; padding: 1.5rem; background: #0c0c14; color: #f3f4f6; line-height: 1.6; }
      a { color: #c4a8ff; }
    </style>
  </head>
  <body>
    <h1>Studio has moved to its own app</h1>
    {studioUrl ? <p><a href={studioUrl}>Open CRUDForge Studio</a></p> : <p>The standalone Studio deployment link will be available here once it is configured.</p>}
    <p><a href="/guides/studio/">Read the Studio guide</a> · <a href="/">Return to documentation</a></p>
  </body>
</html>
